"""
FreeCAD MCP Socket Server
Run this macro inside FreeCAD GUI to enable MCP tools to work directly
in your running FreeCAD instance.

Usage: In FreeCAD, go to Macro -> Macros -> select this file -> Execute
"""

import socket
import threading
import json
import queue
import itertools
import os
import time
import hmac
import secrets
import FreeCAD
import FreeCADGui
import Part

try:
    from PySide6 import QtCore
except ImportError:
    from PySide2 import QtCore

MCP_PORT = 12345
MCP_EXEC_TIMEOUT = 30
MCP_CLIENT_IDLE_TIMEOUT = 10
MCP_MAX_REQUEST_BYTES = 10485760
MCP_END = b'\n__MCP_END__\n'
MCP_AUTH_PREFIX = b'__MCP_AUTH__:'
MCP_TOKEN_DIR = os.path.join(os.path.expanduser('~'), '.freecad-mcp')
MCP_TOKEN_FILE = os.path.join(MCP_TOKEN_DIR, 'token')

_cmd_queue = queue.Queue()
# Request ids come from a counter, not id(): an id() can be reused after a request is gone.
_req_ids = itertools.count(1)
# _result_events holds the requests whose caller is still waiting; _started the ones the main thread
# has begun to run. Both are read and changed under _state_lock.
_state_lock = threading.Lock()
_started = set()
_result_dict = {}
_result_events = {}
_server_running = False


def _mcp_json(value):
    # json.dumps cannot encode FreeCAD types. Quantities (Length, Angle, ...) become
    # their number in internal units, vectors a list, anything else its repr.
    if isinstance(value, FreeCAD.Units.Quantity):
        return value.Value
    if isinstance(value, FreeCAD.Vector):
        return [value.x, value.y, value.z]
    return repr(value)


def _write_token():
    # A new token on every start, readable only by the user (dir 0700, file 0600, also when they
    # already existed with wider modes). The token itself is never printed or returned.
    token = secrets.token_hex(32)
    os.makedirs(MCP_TOKEN_DIR, mode=0o700, exist_ok=True)
    os.chmod(MCP_TOKEN_DIR, 0o700)
    fd = os.open(MCP_TOKEN_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        os.fchmod(fd, 0o600)
        os.write(fd, token.encode('ascii'))
    finally:
        os.close(fd)
    return token


def _send_json(conn, obj):
    conn.sendall(json.dumps(obj).encode('utf-8'))


def _reject_oversized(conn):
    # Answer, half-close, then drain what the client is still sending: close() with unread input
    # sends a TCP reset and the client would lose the response.
    _send_json(conn, {"success": False, "error": "Request exceeds %d bytes" % MCP_MAX_REQUEST_BYTES})
    try:
        conn.shutdown(socket.SHUT_WR)
        deadline = time.monotonic() + 5.0
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                break
            conn.settimeout(remaining)
            if not conn.recv(65536):
                break
    except OSError:
        pass


def _handle_client(conn, token):
    try:
        # A client that connects and then stays silent would block the macro, which serves one
        # connection at a time; drop it after MCP_CLIENT_IDLE_TIMEOUT seconds without data.
        conn.settimeout(MCP_CLIENT_IDLE_TIMEOUT)
        data = bytearray()
        while True:
            chunk = conn.recv(65536)
            if not chunk:
                break
            data += chunk
            if len(data) > MCP_MAX_REQUEST_BYTES:
                _reject_oversized(conn)
                return
            if data.find(MCP_END, max(0, len(data) - len(chunk) - len(MCP_END))) != -1:
                break

        request = bytes(data).split(MCP_END, 1)[0]
        first_line, _, code = request.partition(b'\n')
        supplied = first_line[len(MCP_AUTH_PREFIX):] if first_line.startswith(MCP_AUTH_PREFIX) else b''
        if not hmac.compare_digest(supplied, token.encode('ascii')):
            if data:  # an empty connection (bridge checkSocket, probes) is not an attack; log no value from the request
                FreeCAD.Console.PrintWarning("MCP Server: rejected unauthorized request\n")
            _send_json(conn, {"success": False, "error": "Unauthorized"})
            return
        code = code.decode('utf-8')

        event = threading.Event()
        req_id = next(_req_ids)
        with _state_lock:
            _result_events[req_id] = event

        _cmd_queue.put((req_id, code))

        event.wait(timeout=MCP_EXEC_TIMEOUT)

        # From here on the main thread skips this request if it has not started it yet, and drops
        # its result if it is still running.
        with _state_lock:
            _result_events.pop(req_id, None)
            result = _result_dict.pop(req_id, None)
            was_started = req_id in _started
            _started.discard(req_id)
        if result is None:
            if was_started:
                result = {"success": False, "error": "Timeout after %ss: the code is still running in FreeCAD" % MCP_EXEC_TIMEOUT}
            else:
                result = {"success": False, "error": "Timeout after %ss: FreeCAD was busy and the code was not run" % MCP_EXEC_TIMEOUT}

        try:
            response = json.dumps(result, default=_mcp_json).encode('utf-8')
        except ValueError as err:  # e.g. a circular reference
            response = json.dumps({"success": False, "error": "Result could not be encoded: " + str(err)}).encode('utf-8')
        conn.sendall(response)
    except Exception as e:
        try:
            conn.sendall(json.dumps({"success": False, "error": str(e)}).encode('utf-8'))
        except:
            pass
    finally:
        conn.close()


def _socket_server():
    global _server_running
    server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        server.bind(('127.0.0.1', MCP_PORT))
    except OSError as e:
        FreeCAD.Console.PrintError(f"MCP Server: Port {MCP_PORT} already in use: {e}\n")
        return
    server.listen(1)
    # The token is written only once this instance owns the port: a second start whose bind fails
    # leaves the running server's token file alone.
    try:
        token = _write_token()
    except OSError as e:
        FreeCAD.Console.PrintError(f"MCP Server: cannot write token file {MCP_TOKEN_FILE}: {e}\n")
        server.close()
        return
    server.settimeout(1.0)
    _server_running = True
    FreeCAD.Console.PrintMessage(f"MCP Socket Server listening on 127.0.0.1:{MCP_PORT}\n")
    FreeCAD.Console.PrintMessage(f"MCP Server: auth token written to {MCP_TOKEN_FILE}\n")

    while _server_running:
        try:
            conn, addr = server.accept()
            _handle_client(conn, token)
        except socket.timeout:
            continue
        except Exception as e:
            if _server_running:
                FreeCAD.Console.PrintError(f"MCP Server error: {e}\n")

    server.close()
    FreeCAD.Console.PrintMessage("MCP Socket Server stopped.\n")


def _process_queue():
    while not _cmd_queue.empty():
        try:
            req_id, code = _cmd_queue.get_nowait()
            with _state_lock:
                if req_id not in _result_events:
                    continue  # the caller timed out before it started: never run it
                _started.add(req_id)
            _mcp_result = {"success": True}
            exec_globals = dict(globals())
            exec_globals["_mcp_result"] = _mcp_result
            try:
                exec(code, exec_globals)
                _mcp_result = exec_globals["_mcp_result"]
            except Exception as e:
                _mcp_result = {"success": False, "error": str(e)}

            with _state_lock:
                _started.discard(req_id)
                event = _result_events.get(req_id)
                if event is not None:
                    _result_dict[req_id] = _mcp_result
                    event.set()
        except queue.Empty:
            break


# Start socket server thread
_server_thread = threading.Thread(target=_socket_server, daemon=True)
_server_thread.start()

# Poll queue on main thread via QTimer
_timer = QtCore.QTimer()
_timer.timeout.connect(_process_queue)
_timer.start(50)

FreeCAD.Console.PrintMessage("MCP Server macro loaded. Waiting for connections...\n")
